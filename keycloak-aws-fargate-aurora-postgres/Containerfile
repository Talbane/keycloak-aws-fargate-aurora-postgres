# syntax=docker/dockerfile:1
# The workflow resolves the release tag to a digest and passes KEYCLOAK_IMAGE as quay.io/keycloak/keycloak@sha256:... so the optimized build is reproducible.
ARG KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.2

FROM ${KEYCLOAK_IMAGE} AS builder

WORKDIR /opt/keycloak
# AWS RDS CA bundle for full PostgreSQL TLS server verification.
ADD --chown=keycloak:keycloak --chmod=0444 https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem /opt/keycloak/conf/rds-global-bundle.pem

RUN /opt/keycloak/bin/kc.sh build --db=postgres --health-enabled=true --metrics-enabled=true

FROM ${KEYCLOAK_IMAGE}
COPY --from=builder /opt/keycloak/ /opt/keycloak/
COPY --chown=keycloak:keycloak --chmod=0555 scripts/container-entrypoint.sh /opt/keycloak/bin/container-entrypoint.sh

ENTRYPOINT ["/opt/keycloak/bin/container-entrypoint.sh"]
CMD ["start", "--optimized"]
